# xAI / Grok API Config
XAI_API_KEY=
XAI_MODEL=grok-4.5

# MQTT Broker Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC=hospital/+/+/+/+

# JWT Authentication
JWT_SECRET=aura_reliability_intelligence_secret_2026

# API security (override every one of these in production)
AURA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AURA_INGEST_API_KEY=
AURA_SEED_PASSWORD=

# Runtime data locations (defaults resolve inside the repository)
AURA_DATA_ROOT=
AURA_MODELS_DIR=
AURA_ARTIFACTS_DIR=
AURA_DATA_RAW_DIR=
AURA_DATA_PROCESSED_DIR=
AURA_KNOWLEDGE_BASE_DIR=
AURA_UPLOADED_DATASETS_DIR=
AURA_ARCHIVE_DIR=
AURA_DB_PATH=
